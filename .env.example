# Copiez ce fichier en ".env" et remplissez la clé.
# Clé API Claude (https://platform.claude.com → API Keys). Sans clé, l'appli marche mais sans analyses.
ANTHROPIC_API_KEY=

# Modèle utilisé pour les analyses (claude-haiku-5-5 = très économique ; claude-opus-5-5 = plus poussé, plus cher)
TRYHARD_MODEL=claude-haiku-5-5

# Nombre maximum d'analyses Claude par collecte (contrôle du coût)
TRYHARD_MAX_ANALYSES=40

# Port du serveur
PORT=3000

# 127.0.0.1 = seulement ce PC ; 0.0.0.0 = aussi accessible depuis un téléphone sur le même Wi-Fi
HOST=127.0.0.1
